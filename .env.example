# for an safety check in `remove_old_backups.sh`
CURR_PWD=<abs path>

# set these to files you do NOT want to detect as an old backup and be deleted!!
# this file should only be sourced by bash, so use bash array syntax
BACKUPS_IGNORED_FILES=(".*")

# stores 2 days of backups at 4h per backup
MAX_BACKUP_COUNT=12
